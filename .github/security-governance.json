{
  "schema_version": 1,
  "_comment": "Configuração versionada de governança de segurança (SPEC 007 / issue #450). Ver docs/security-baseline-ghe.md, seções 9 a 16. Repositórios de projeto copiam este arquivo e ajustam branches, checks e comandos; a varredura semanal lê a cópia de cada repositório (fallback: esta configuração).",
  "branches": {
    "default_branch": "auto",
    "production_branches": [
      "main"
    ],
    "protected_patterns": [
      "release/*",
      "hotfix/*"
    ],
    "additional_branches": []
  },
  "branch_rules": {
    "prefer_rulesets": true,
    "required_approving_review_count": 1,
    "require_code_owner_review": true,
    "dismiss_stale_reviews": true,
    "block_direct_push": true,
    "block_force_push": true,
    "block_deletion": true,
    "require_status_checks": true,
    "require_up_to_date_branch": true,
    "require_conversation_resolution": true,
    "merge_queue": "optional"
  },
  "required_status_checks": {
    "build": [
      "build"
    ],
    "unit_tests": [
      "unit-tests"
    ],
    "integration_tests": [],
    "coverage": [],
    "sast": [
      "CodeQL"
    ],
    "sca": [
      "dependency-review"
    ],
    "secret_scanning": [
      "secret-scan"
    ],
    "governance": [
      "governance-config"
    ]
  },
  "quality_gates": {
    "build": {
      "setup_command": "python3 -c 'import yaml' 2>/dev/null || python3 -m pip install --user --break-system-packages 'pyyaml==6.0.2'",
      "command": "bash scripts/validate-repo-static.sh"
    },
    "unit_tests": {
      "setup_command": "command -v bats >/dev/null 2>&1 || sudo npm install -g bats@1.13.0",
      "command": "./scripts/run-tests.sh"
    },
    "integration_tests": {
      "command": "",
      "not_applicable_reason": "A suíte única scripts/run-tests.sh já executa os testes de integração (.test.sh/.bats) deste repositório; não existe um estágio separado de integração."
    }
  },
  "coverage": {
    "mode": "not-applicable",
    "not_applicable_reason": "Repositório predominantemente shell/documentação/YAML: não há ferramenta de cobertura aplicável e pinada no runner. O gate obrigatório é a suíte de testes (check unit-tests); nenhuma métrica de cobertura é inventada.",
    "report_path": "",
    "report_format": "auto",
    "global_min_percent": 80,
    "diff_min_percent": 80,
    "baseline_percent": null,
    "allow_decrease_without_exception": false,
    "setup_command": "",
    "command": ""
  },
  "codeql": {
    "languages": [
      "actions",
      "python"
    ],
    "max_analysis_age_days": 8,
    "blocking_security_severities": [
      "critical",
      "high"
    ]
  },
  "dependency_review": {
    "config_file": ".github/dependency-review-config.yml",
    "unsupported_behavior": "fail"
  },
  "secret_scanning": {
    "require_secret_scanning": true,
    "require_push_protection": true
  },
  "exceptions_file": ".github/security-exceptions.json"
}
